{
  "name": "@speckit/core-server",
  "version": "0.3.25",
  "private": true,
  "description": "SpecKit Core Server — Node.js HTTP API for cross-IDE support",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/server.ts --bundle --platform=node --target=node18 --outfile=dist/server.bundle.js --external:fsevents",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.3.3"
  }
}
