.vscode/**
.vscode-test/**
.github/**
src/**
out/**
**/node_modules/**
speckit-agent/**
tests/**
scripts/**

# Build & config files
.gitignore
.yarnrc
esbuild.js
tsconfig.json
tsconfig.integration.json
vitest.config.ts
vitest.behavioral.config.ts
eslint.config.mjs
.prettierignore
.prettierrc*
CLAUDE.md

# Dev tooling
.husky/**
.claude/**
.copilot/**
.speckit/**
.venv/**
venv/**
env/**
__pycache__/**

# Coverage reports
coverage/**

# Asset diagrams
assets/diagrams/**
assets/presentation/**

# Source maps (debug only)
**/*.js.map

# PDF / docs artifacts
markdown-to-pdf/**

# Publish archives
publish/**

# Sibling workspace packages (not shipped in the VS Code extension VSIX)
# - packages/intellij/ ~179 MB of JetBrains plugin sources/build artifacts
# - packages/core-server/ standalone HTTP server (not consumed by extension.js at runtime)
packages/**

# Local run logs (vitest, tsc, lint, build, etc.)
*.log
**/*.log

# Reports (mutation testing, coverage, etc.)
reports/**

# Memory/scratch
# (already excluded above in Dev tooling block)

# Dotfiles that should never ship
.editorconfig
.gitattributes
.lintstagedrc*
.commitlintrc*
.releaserc*
.npmrc
